resource_groups = {
  "rg-hub-network-prod" = {
    location = "eastus"
    tags = {
      Environment = "Production"
      Tier        = "Connectivity"
      Owner       = "Mohammad Sadique Qutub"
    }
  }
  "rg-spoke-workload-prod" = {
    location = "eastus"
    tags = {
      Environment = "Production"
      Tier        = "Workloads"
      Owner       = "Mohammad Sadique Qutub"
    }
  }
}

vnets_nested_map = {
  "vnet-hub-prod" = {
    resource_group_name = "rg-hub-network-prod"
    location            = "eastus"
    address_space       = ["10.100.0.0/16"]
    subnets = {
      "GatewaySubnet" = {
        address_prefixes  = ["10.100.1.0/24"]
        service_endpoints = []
      }
      "AzureFirewallSubnet" = {
        address_prefixes  = ["10.100.2.0/24"]
        service_endpoints = []
      }
      "snet-management" = {
        address_prefixes  = ["10.100.10.0/24"]
        service_endpoints = ["Microsoft.Storage", "Microsoft.KeyVault"]
        nsg_rules = {
          "AllowBastionInbound" = {
            priority                   = 100
            direction                  = "Inbound"
            access                     = "Allow"
            protocol                   = "Tcp"
            source_port_range          = "*"
            destination_port_range     = "443"
            source_address_prefix      = "Internet"
            destination_address_prefix = "*"
          }
        }
      }
    }
  }
}

storage_nestedmap = {
  "stgproddata01" = {
    name                     = "stgproddatamad01"
    resource_group_name      = "rg-spoke-workload-prod"
    location                 = "eastus"
    account_tier             = "Standard"
    account_replication_type = "GRS"
  }
  "stgprodlogs02" = {
    name                     = "stgprodlogsmad02"
    resource_group_name      = "rg-hub-network-prod"
    location                 = "eastus"
    account_tier             = "Premium"
    account_replication_type = "ZRS"
  }
}
